#=============================================================================
# AI Guardrails — Environment Configuration (.env.example)
#=============================================================================
# Copy this file to .env and edit the values. The .env file is NOT committed
# to git (it is in .gitignore) because it contains secrets.
#
# All paths are resolved relative to the guardrail package directory — nothing
# is hardcoded to /home/pymite6941 or any specific host. The same package runs
# on a Raspberry Pi, desktop, or inside a Docker container.
#=============================================================================

# ── Server ──────────────────────────────────────────────────────────────────

# Host to bind the guardrail API server to.
#   0.0.0.0 = all interfaces (Docker/external access - use with firewall)
#   127.0.0.1 = localhost only (most secure, default)
GUARDRAIL_HOST=127.0.0.1

# HTTP port for the API server and web UI.
GUARDRAIL_PORT=8083

# Host to bind the API server to (default: 127.0.0.1 for security).
#   0.0.0.0 = all interfaces (for Docker/external access)
#   127.0.0.1 = localhost only (most secure, default)
GUARDRAIL_BIND_HOST=127.0.0.1

# ── Authentication ──────────────────────────────────────────────────────────

# Admin API key for programmatic access to write/delete/monitor endpoints.
# Required if you do not use password-based login. Generate a strong key:
#   openssl rand -hex 32
GUARDRAIL_API_KEY=your_admin_api_key_here

# Optional view-only API key for read endpoints (GET /api/policies, /api/stats,
# /api/guardrail-status). If unset, view endpoints require a session.
GUARDRAIL_VIEW_KEY=your_view_api_key_here

# Admin login password for the web UI. On first start, this is hashed with
# PBKDF2-HMAC-SHA256 (200,000 iterations) and stored locally at:
#   ~/.ai_guardrails_auth.json
# The hash (not the plaintext password) is what is kept on disk. The raw
# password is never written to disk. Set this once; subsequent starts read
# the stored hash.
GUARDRAIL_ADMIN_PASSWORD=your_admin_password_here

# Session lifetime in seconds (default 3600 = 1 hour).
GUARDRAIL_SESSION_TTL=3600

# ── IP allowlist ────────────────────────────────────────────────────────────

# Comma-separated list of IPs or CIDR ranges allowed to access the API.
# Empty = allow all IPs. Example:
#   GUARDRAIL_ALLOWED_IPS=10.0.0.0/8,192.168.1.50,2001:db8::/32
GUARDRAIL_ALLOWED_IPS=

# ── CORS / cross-origin ─────────────────────────────────────────────────────

# Comma-separated list of origins allowed to call the API from a browser.
# Empty = CORS disabled (no cross-origin browser access).
# Example: https://your-dashboard.example.com
GUARDRAIL_ALLOWED_ORIGINS=

# ── Login rate limiting (stricter than general API rate limit) ─────────────

# Max login attempts per minute per IP (default 5).
GUARDRAIL_LOGIN_RATE_LIMIT=5

# Lockout duration in seconds after max failed attempts (default 300 = 5 min).
GUARDRAIL_LOGIN_LOCKOUT_SECONDS=300

# Max failed login attempts before lockout (default 5).
GUARDRAIL_LOGIN_MAX_ATTEMPTS=5

# ── Password complexity requirements ───────────────────────────────────────

# Minimum password length (default 8).
GUARDRAIL_PASSWORD_MIN_LENGTH=8

# Require at least one uppercase letter (default true).
GUARDRAIL_PASSWORD_REQUIRE_UPPER=true

# Require at least one lowercase letter (default true).
GUARDRAIL_PASSWORD_REQUIRE_LOWER=true

# Require at least one digit (default true).
GUARDRAIL_PASSWORD_REQUIRE_DIGIT=true

# Require at least one special character (default true).
GUARDRAIL_PASSWORD_REQUIRE_SPECIAL=true

# ── Session binding ────────────────────────────────────────────────────────

# Bind sessions to the source IP address (prevents session hijacking).
#   true = reject sessions from different IPs (default)
#   false = allow sessions from any IP
GUARDRAIL_SESSION_BIND_IP=true

# ── Rate limiting (general API) ────────────────────────────────────────────

# Max requests per minute per API key or IP address (default 60).
GUARDRAIL_RATE_LIMIT=60

# ── Logging ─────────────────────────────────────────────────────────────────

# Directory for all guardrail log files (default: <project>/logs).
# All modules write structured JSONL logs here.
AI_GUARDRAILS_LOG_DIR=./logs

# Minimum log level: DEBUG, INFO, WARN, ERROR, CRITICAL (default: INFO).
AI_GUARDRAIL_LOG_LEVEL=INFO

# Log rotation: rotate when a file exceeds this many MB (default: 10).
AI_GUARDRAIL_LOG_ROTATE=10

# Number of rotated log files to keep (default: 5).
AI_GUARDRAIL_LOG_KEEP=5

# ── Cron / scheduled jobs ───────────────────────────────────────────────────

# Cron jobs are installed via: ./scripts/cron/setup_cron.sh install
# These env vars control cron job behavior:

# Port for canary probes to hit the live server (default: 8083).
GUARDRAIL_CANARY_PORT=8083

# Host for canary probes (default: 127.0.0.1).
GUARDRAIL_CANARY_HOST=127.0.0.1

# ── Request limits ──────────────────────────────────────────────────────────

# Max request body size in bytes (default 1048576 = 1 MB).
GUARDRAIL_MAX_BODY_SIZE=1048576

# ── Outer model (monitor) ───────────────────────────────────────────────────

# Enable an outside model to review inner AI thoughts/actions.
GUARDRAIL_OUTSIDE_MODEL_ENABLED=0
GUARDRAIL_OUTSIDE_MODEL_BASE_URL=http://localhost:11434
GUARDRAIL_OUTSIDE_MODEL_MODEL=qwen2.5:1.5b
GUARDRAIL_OUTSIDE_MODEL_ENDPOINT=generate
GUARDRAIL_OUTSIDE_MODEL_TIMEOUT=30

# ── Trusted model (bootstrapped monitoring level T) ─────────────────────────

# A weaker-but-trusted model that audits the outer monitor's reasoning for
# collusion / rubber-stamping.
GUARDRAIL_TRUSTED_MODEL_ENABLED=0
GUARDRAIL_TRUSTED_MODEL_BASE_URL=http://localhost:8000
GUARDRAIL_TRUSTED_MODEL_MODEL=trusted-model
GUARDRAIL_TRUSTED_MODEL_ENDPOINT=chat
GUARDRAIL_TRUSTED_MODEL_TIMEOUT=30

# ── Classifier (second-opinion LLM) ─────────────────────────────────────────

# LLM-based classifier that runs after the deterministic engine to catch
# creative injection attempts regex misses. It can only escalate a decision,
# never release one.
GUARDRAIL_CLASSIFIER_ENABLED=0
GUARDRAIL_CLASSIFIER_BASE_URL=http://localhost:8000
GUARDRAIL_CLASSIFIER_MODEL=classifier-model
GUARDRAIL_CLASSIFIER_ENDPOINT=chat
GUARDRAIL_CLASSIFIER_API_STYLE=auto
GUARDRAIL_CLASSIFIER_TIMEOUT=20
GUARDRAIL_CLASSIFIER_API_KEY=

# ── Nebius Token Factory (OpenAI-compatible LLM provider) ───────────────────
# Nebius provides hosted open-weight models via an OpenAI-compatible API.
# Get a free API key at https://dev.nebius.com/builders (includes $25 credit).
#
# Example: use Nebius as the outside monitor model:
#   GUARDRAIL_OUTSIDE_MODEL_ENABLED=1
#   GUARDRAIL_OUTSIDE_MODEL_BASE_URL=https://api.tokenfactory.nebius.com/v1/
#   GUARDRAIL_OUTSIDE_MODEL_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
#   GUARDRAIL_OUTSIDE_MODEL_ENDPOINT=chat/completions
#   GUARDRAIL_OUTSIDE_MODEL_API_KEY=your_nebius_api_key_here
#
# Or as the classifier (second-opinion LLM), using an NVIDIA Nemotron model:
#   GUARDRAIL_CLASSIFIER_ENABLED=1
#   GUARDRAIL_CLASSIFIER_BASE_URL=https://api.tokenfactory.nebius.com/v1
#   GUARDRAIL_CLASSIFIER_MODEL=nvidia/Nemotron-3.5-Super-VL
#   GUARDRAIL_CLASSIFIER_API_STYLE=openai
#   GUARDRAIL_CLASSIFIER_API_KEY=your_nebius_api_key_here
#
# API_STYLE=auto detects the wire format from the base URL: any /v1 base is
# treated as OpenAI-compatible (POST {base}/chat/completions), everything else
# as Ollama (POST {base}/api/chat).
#
# Model ids change as Nebius adds models — always confirm with:
#   curl -H "Authorization: Bearer $KEY" https://api.tokenfactory.nebius.com/v1/models
#
# Models available on Nebius Token Factory include:
#   nvidia/Nemotron-3.5-Super-VL   (NVIDIA open model — hackathon requirement)
#   meta-llama/Meta-Llama-3.1-70B-Instruct
#   meta-llama/Meta-Llama-3.1-405B-Instruct
#   deepseek-ai/DeepSeek-R1-0528
#   Qwen/Qwen3-235B-A22B
#   and many more — see https://docs.tokenfactory.nebius.com/
GUARDRAIL_NEBIUS_API_KEY=
GUARDRAIL_NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
GUARDRAIL_NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# ── Nemus Cloud (NVIDIA Nemotron) ───────────────────────────────────────────
# Nemus cloud provides NVIDIA models via an OpenAI-compatible API.
# Get an API key at https://dev.nebius.com/builders
#
# Example: use Nemus as the outside monitor model:
#   GUARDRAIL_OUTSIDE_MODEL_ENABLED=1
#   GUARDRAIL_OUTSIDE_MODEL_BASE_URL=https://api.nemus.cloud/v1/
#   GUARDRAIL_OUTSIDE_MODEL_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
#   GUARDRAIL_OUTSIDE_MODEL_ENDPOINT=chat/completions
#   GUARDRAIL_OUTSIDE_MODEL_API_KEY=your_nemus_api_key_here
#
# Models available on Nemus include:
#   nvidia/nemotron-3.5-super-vl-120b-a12b
#   nvidia/llama-3.1-nemotron-70b-instruct
#   and others — see https://dev.nebius.com/
GUARDRAIL_NEMUS_API_KEY=
GUARDRAIL_NEMUS_BASE_URL=https://api.nemus.cloud/v1/
GUARDRAIL_NEMUS_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# ── Custom Domain Model Configuration ──────────────────────────────────────
# Point your AI model to a domain you own. The guardrails will validate the
# domain (DNS resolution, SSRF protection, SSL certificate) before connecting.
#
# Example: your own domain with HTTPS
#   GUARDRAIL_CUSTOM_DOMAIN_BASE_URL=https://models.yourdomain.com/v1/
#   GUARDRAIL_CUSTOM_DOMAIN_MODEL=your-model-name
#   GUARDRAIL_CUSTOM_DOMAIN_ENDPOINT=chat/completions
#   GUARDRAIL_CUSTOM_DOMAIN_API_KEY=your_api_key_here
#
# The domain will be:
#   - Validated for proper DNS format (RFC 1123)
#   - Resolved via DNS to confirm it's reachable
#   - Checked against private/internal address ranges (SSRF protection)
#   - SSL certificate validated (if HTTPS)
#
# Get a free API key at https://dev.nebius.com/builders (includes $25 credit)
# and use it with your own domain or any OpenAI-compatible endpoint.
GUARDRAIL_CUSTOM_DOMAIN_BASE_URL=
GUARDRAIL_CUSTOM_DOMAIN_MODEL=
GUARDRAIL_CUSTOM_DOMAIN_ENDPOINT=chat/completions
GUARDRAIL_CUSTOM_DOMAIN_API_KEY=

# ── Human-in-the-loop escalation ────────────────────────────────────────────

# Escalate medium+ risk conversations to a human reviewer (webhook or console).
GUARDRAIL_HUMAN_LOOP_ENABLED=0
GUARDRAIL_HUMAN_LOOP_MODE=console          # console | webhook
GUARDRAIL_HUMAN_LOOP_WEBHOOK_URL=
GUARDRAIL_HUMAN_LOOP_WEBHOOK_API_KEY=
GUARDRAIL_HUMAN_LOOP_ESCALATE_AT=medium    # low | medium | high | critical
GUARDRAIL_HUMAN_LOOP_DECISION_TIMEOUT_SEC=60

# ── Liveness canary ─────────────────────────────────────────────────────────

# Synthetic probes run on a schedule to verify the guardrail gate is still
# firing. Alerts after consecutive failures (catches a "dead gate").
GUARDRAIL_CANARY_INTERVAL_SEC=300
GUARDRAIL_CANARY_ALERT_AFTER_FAILURES=3

# ── Hardware optimization ───────────────────────────────────────────────────

# These are normally auto-detected. Override only if needed.
#   GUARDRAIL_PARALLEL_CHECKS=2
#   GUARDRAIL_PREFER_RUST_SCANNER=1
#   GUARDRAIL_MAX_INPUT_LENGTH=4096
#   GUARDRAIL_MAX_OUTPUT_LENGTH=8192
#   GUARDRAIL_LOG_LEVEL=INFO
#   GUARDRAIL_OUTSIDE_MODEL_MODEL=qwen2.5:1.5b
#   GUARDRAIL_IN_CONTAINER=1
#   GUARDRAIL_IS_PI=1

GUARDRAIL_PARALLEL_CHECKS=2
GUARDRAIL_PREFER_RUST_SCANNER=1
GUARDRAIL_MAX_INPUT_LENGTH=4096
GUARDRAIL_MAX_OUTPUT_LENGTH=8192
GUARDRAIL_IN_CONTAINER=0
GUARDRAIL_IS_PI=0
GUARDRAIL_PI_MODEL=

# ── Host header validation (BadHost protection) ─────────────────────────────

# Comma-separated list of allowed Host header values. Empty = accept any host.
# Example: GUARDRAIL_ALLOWED_HOSTS=localhost,127.0.0.1,my-pi.local
GUARDRAIL_ALLOWED_HOSTS=

# ── SSRF protection (for external model URLs) ───────────────────────────────

# Enable SSRF protection for outside model and trusted model URLs.
# When enabled, blocks URLs targeting private/internal addresses.
#   GUARDRAIL_SSRF_PROTECTION=1
GUARDRAIL_SSRF_PROTECTION=0

# ── Integrity watcher key ───────────────────────────────────────────────────

# Signing key for the tamper-evident integrity watcher.
# Required to run: python3 guardrail_integrity.py init
# Keep this key outside the agent's reach.
GUARDRAIL_INTEGRITY_KEY=

# ── Security update tracking ────────────────────────────────────────────────

# State is stored locally at: ~/.ai_guardrails_update_state.json
# No env vars required — use the CLI:
#   python3 guardrail_updates.py refresh
#   python3 guardrail_updates.py summary
#   python3 guardrail_updates.py due --set rust_scanner 2027-01-01
#   python3 guardrail_updates.py applied rust_scanner 0.2.0

#=============================================================================
# WHERE THE PASSWORD HASH IS STORED
#=============================================================================
# The web UI login password is never stored in plaintext.
#
# On first start (when GUARDRAIL_ADMIN_PASSWORD is set), the password is
# hashed with PBKDF2-HMAC-SHA256 (200,000 iterations, random 16-byte salt)
# and saved to:
#
#   ~/.ai_guardrails_auth.json
#
# The file contains only:
#   - password_hash   (hex-encoded PBKDF2 hash)
#   - salt            (hex-encoded random salt)
#   - created_at      (ISO timestamp)
#
# The file is created with mode 0600 (owner read/write only).
# The raw password is never written to disk and is never transmitted after
# the initial login request (which is sent over the local HTTP connection).
#
# To rotate the password: delete ~/.ai_guardrails_auth.json and restart with
# a new GUARDRAIL_ADMIN_PASSWORD, or use the set_password() function
# programmatically.
#=============================================================================
